{
    "compilerOptions": {
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2018",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "outDir": "./dist"
    },
    "include": ["**/*.ts"],
    "exclude": ["www/functions/**", "node_modules/**", "dist/**", "tools/**"]
}
